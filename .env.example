# ========================================================
# GraphRAG Platform - Environment Configuration Template
# ========================================================
# Rename this file to '.env' and populate with your values

# --- Security ---
# Secret key used for signing JWT tokens. 
# Generate a secure one using: openssl rand -hex 32
JWT_SECRET=change-me-in-production-to-a-secure-random-string

# Token expiration in hours (default: 24)
JWT_EXPIRATION_HOURS=24

# --- Initial Superadmin Account ---
# Credentials for the first superadmin account (auto-created on first boot)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@graphrag.local

# --- Rate Limiting ---
# Maximum number of API requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# --- LLM Provider API Keys ---
# Add API keys for whichever providers you plan to use in the UI settings
GRAPHRAG_API_KEY=your_openai_or_provider_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- System ---
# Directory to store persistent SQLite database (default is 'data')
GRAPHRAG_DATA_DIR=data
